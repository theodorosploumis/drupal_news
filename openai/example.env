# Copy this file to .env and fill in real values
TIMEZONE=Europe/Athens

# Email configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=postmaster@example.com
SMTP_PASS=CHANGEME
MAIL_TO=news@example.com
MAIL_FROM="Drupal Weekly <postmaster@example.com>"

# Provider credentials
OPENAI_API_KEY=sk-openai-example
ANTHROPIC_API_KEY=sk-anthropic-example
GOOGLE_API_KEY=sk-gemini-example
OLLAMA_BASE_URL=http://localhost:11434
LMSTUDIO_BASE_URL=http://localhost:1234
QWEN_API_KEY=sk-qwen-example
GROK_API_KEY=sk-grok-example
DEEPSEEK_API_KEY=sk-deepseek-example
OPENROUTER_API_KEY=sk-openrouter-example

# Retention and cache settings
LOG_RETENTION_DAYS=45
RUN_RETENTION_DAYS=90
CACHE_DB_PATH=./cache/cache.db
CACHE_TTL_DAYS=21
